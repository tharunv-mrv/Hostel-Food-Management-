# ==============================================================================
# Hostel Food Management System - Environment Configuration Template
# Copy this file to .env for local overrides, or set these in Render Environment
# ==============================================================================

# Application Security
# In production, set to a cryptographically strong random key (e.g. generated by Render)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_ENV=production
PORT=10000

# Database Configuration
# Local SQLite default: sqlite:///instance/hostel_food.db
# Render PostgreSQL example: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///instance/hostel_food.db

# Initial Admin Credentials (Created automatically on first start if no admin exists)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_EMAIL=admin@canteen.edu

# Default Student Initial Password
DEFAULT_STUDENT_PASSWORD=Student@123

# Face Recognition Settings (Cosine similarity threshold for SFace; 0.363 is recommended)
RECOGNITION_THRESHOLD=0.363

# Server Timezone (Default: Indian Standard Time)
TIMEZONE=Asia/Kolkata

# Meal Service Hours (24-Hour HH:MM format)
BREAKFAST_START_TIME=07:30
BREAKFAST_END_TIME=10:30
BREAKFAST_ENABLED=True

LUNCH_START_TIME=11:30
LUNCH_END_TIME=15:30
LUNCH_ENABLED=True

# Policy Enforcements (Set to True for strict production enforcement)
ENFORCE_MEAL_HOURS=False
FEE_POLICY_ENFORCED=False
MAX_PERMITTED_FEE_BALANCE=5000.0
DEFAULT_HOSTEL_FEE=75000.0

# SMS Provider Configuration
# Supported providers: mock, fast2sms, twilio
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=HSTLFD
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Security & Defense-in-Depth Policies
CSRF_ENABLED=True
RATE_LIMIT_ENABLED=True
MAX_CONTENT_LENGTH=16777216
DATA_RETENTION_POLICY=archive
ALLOW_PERMANENT_DELETION=False
